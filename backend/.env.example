DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email: console backend is used automatically when DEBUG=true.
# Configure SMTP for production.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=WayTogether <no-reply@your-domain.example>

# Development only: logs a phone OTP to the Django console.
# Production requires an approved SMS provider adapter; keep this false.
SMS_OTP_CONSOLE=true
