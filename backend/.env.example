DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
REDIS_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local development defaults. Set these explicitly for production.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_PROXY_SSL_HEADER=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Local path by default. In production, point this at a private persistent disk.
MEDIA_ROOT=

# Email: console backend is used automatically when DEBUG=true.
# Configure Gmail SMTP for production. Use a Google App Password, never your normal Google password.
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-google-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=WayTogether <your-gmail-address@gmail.com>

# Account registration uses email OTP only. Phone number is optional profile information.

# Map/geocoding services
# Location search is explicitly user-triggered, cached and globally limited to one uncached request/second.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
MAPS_USER_AGENT=WayTogether/1.0 (+https://github.com/Nithesh17122004/WayTogether)
# Leave blank until you configure a routing provider whose terms permit your use.
OSRM_ROUTE_URL=

# Razorpay Standard Checkout — Test Mode only. Create credentials in the Razorpay Dashboard's Test Mode.
# The backend rejects live key IDs. Never commit the secret to Git.
RAZORPAY_TEST_MODE=true
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret

# Browser database cleanup is disabled by default; enable temporarily in Render for the one-time admin action.
ADMIN_DATABASE_CLEANUP_ENABLED=false
